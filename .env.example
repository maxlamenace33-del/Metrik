# ==============================================================================
# METRIK — VARIABLES D'ENVIRONNEMENT D'EXEMPLE
# Copiez ce fichier vers .env.local et renseignez vos véritables identifiants.
# ==============================================================================

# URL de votre projet Supabase (trouvable dans Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clé API Anonyme (Anon Public Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key

# Clé API Service Role (Optionnelle - pour scripts serveur sécurisés uniquement)
# ATTENTION: Ne JAMAIS exposer côté client, ne JAMAIS préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key

# URL canonique de l'application (utile pour les redirections d'authentification)
NEXT_PUBLIC_APP_URL=http://localhost:3000
